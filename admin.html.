<style>
:root{--bg:#17110e;--bg2:#221915;--red:#d3171e;--gold:#f4c430;--cream:#fff4dc;--mut:#c9b99b;--line:#3a2c24;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}

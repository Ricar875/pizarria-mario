.it div{flex:1;font-size:15px}.it small{color:var(--mut);display:block}
.it button{background:none;border:0;color:#ff6b6b;font-size:26px;cursor:pointer;padding:4px 10px}
input[type=text],select,textarea{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:10px;color:var(--cream);padding:11px;font:16px Outfit;margin:6px 0}
.er{color:#ff8b8b;min-height:22px;margin-top:6px}

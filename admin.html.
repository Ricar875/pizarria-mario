@media(max-width:760px){.hero .w,.bgrid,.two{grid-template-columns:1fr}nav .links{display:none}nav .btn{margin-left:auto}.hero{padding-top:26px}}

.seg{display:flex;gap:6px}.seg button{flex:1;border:2px solid var(--line);background:none;color:var(--cream);border-radius:12px;padding:9px 6px;font:700 14px Outfit;cursor:pointer}.seg button.on{background:var(--gold);border-color:var(--gold);color:#2a1400}
